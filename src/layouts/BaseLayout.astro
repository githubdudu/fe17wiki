---
import "../styles/global.css";

/** title / description 可选：传了就作为本页的标题（后面接站名）和搜索结果里的描述。 */
interface Props {
	title?: string;
	description?: string;
}
const SITE = "火焰纹章结合 Engage Wiki";
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<!-- 数字字体：Barlow 数字窄而清楚、有等宽数字，用于表格里的数值 -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@500;700&display=swap" />
		<title>{title ? `${title} - ${SITE}` : SITE}</title>
		{description && <meta name="description" content={description} />}
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		font-family: system-ui, sans-serif;
		width: 100%;
		height: 100%;
	}
</style>
