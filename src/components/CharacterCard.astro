---
/** 角色卡片：头像 + 中文名 + 一行副信息，整张卡片链接到角色条目。 */
import Portrait from "./Portrait.astro";

interface Props {
  id: string;
  name: string;
  subtitle?: string;
}
const { id, name, subtitle } = Astro.props;
---

<a class="character-card" href={`/characters/${id}`}>
  <Portrait id={id} alt={name} size={48} />
  <span class="name">{name}</span>
  {subtitle && <span class="subtitle">{subtitle}</span>}
</a>

<style>
  .character-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    text-decoration: none;
    color: inherit;
    text-align: center;
  }
  .name {
    font-size: 0.75rem;
    font-weight: 600;
    color: #2a64b8;
  }
  .subtitle {
    font-size: 0.8rem;
    color: #666;
  }
  .character-card:hover .name {
    text-decoration: underline;
  }
</style>
