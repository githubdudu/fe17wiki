---
/**
 * 时间轴上的一个事件：轴上的圆点 + 编号，虚线连到右边的卡片（章节名 + 在这里加入的人物）。
 * 下面挂着接着它进行的章节（chain，如邪龙之章 1→6）和从它分出的支线（children，外传 / 神龙之章各章）。
 * 支线的轴、圆点、虚线、弯道都在这里画（每层支线都各自拐出来）；主干的那一套在 chapters 页里（它的 li 属于那个文件）。
 * 颜色由 li 上的 data-type 决定，尺寸用页面定义的 --gap / --label-s / --curve。
 */
import Thumb from "./Thumb.astro";

export interface Node {
  id: string;
  type: string;
  no: string;
  name: string;
  chars: { id: string; name: string; img: string }[];
  emblems: { name: string; img: string }[];
  children: Node[];
  /** 接在这个节点后面依次进行的章节（如邪龙之章第2–6章），画成一条小轴而不是层层支线 */
  chain: Node[];
}

interface Props {
  node: Node;
  main?: boolean; // 主线节点：标题用 h2、编号更大
}
const { node, main = false } = Astro.props;
const dlc = node.type === "神龙之章" || node.type === "邪龙之章";
---

{node.type !== "main" && <div class="branch-curve" />}
<div
  class:list={[
    "event",
    { main, dlc, grouped: node.children.length + node.chain.length > 0 },
  ]}
  id={node.id}
>
  <div class="marker">
    <span>{node.no}</span>
    {dlc && <span class="tag">DLC</span>}
  </div>

  <div class="card">
    <h3 class="card-title">
      {node.name}
    </h3>
    {
      (node.chars.length > 0 || node.emblems.length > 0) && (
        <ul class="joins">
          {node.chars.map((c) => (
            <li>
              <a href={`/characters/${c.id}`}>
                <Thumb src={c.img} alt="" size={22} />
                {c.name}
              </a>
            </li>
          ))}
          {node.emblems.map((e) => (
            <li class="emblem">
              <Thumb src={e.img} alt="" size={22} />
              {e.name}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>
{
  node.chain.length > 0 && (
    <ol class="chain">
      {node.chain.map((next) => (
        <li data-type={next.type}>
          <Astro.self node={next} />
        </li>
      ))}
    </ol>
  )
}
{
  node.children.length > 0 && (
    <ul class="branches">
      {node.children.map((child) => (
        <li data-type={child.type}>
          <Astro.self node={child} />
        </li>
      ))}
    </ul>
  )
}

<style>
  /* 曲线 */

  .branch-curve {
    width: calc(var(--gap) + 2px);
    height: var(--curve);
    border-top: 3px solid red;
    border-right: 3px solid var(--axis);
    border-top-right-radius: var(--curve);
  }
  /* ---- 事件本身：圆点左边的编号 + 右侧卡片 ---- */
  .event {
    position: relative;
    display: grid;
    justify-items: start;
  }
  /* 下面还挂着一层（神龙之章 / 邪龙之章第1章）：自己的轴从圆点往下画满这一行，接住下一级 */
  .event.grouped::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(-1 * var(--gap));
    border-left: 3px solid var(--axis);
  }
  /* 编号排在圆点左边（轴外），和圆点同高；太长的自动折行 */
  .marker {
    position: absolute;
    right: calc(100% + var(--gap) + 0.7rem);
    top: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    width: var(--label);
    height: 0;
    color: #262a3f;
    font-size: 0.85rem;
    line-height: 1.25;
    text-align: right;
    font-weight: 700;
  }

  .card {
    padding: 0.25rem 0.8rem 0.25rem;
    margin-bottom: 1rem;
    box-shadow:
      0 0 6px 0px rgb(0 0 0 / 0.1),
      0 2px 4px -2px rgb(0 0 0 / 0.1);
    border-radius: 4px;
    border-left: 3px solid var(--axis);
    background: #fff;
    display: flex;
    gap: 1rem;
    min-width: 12rem;
  }

  .card-title {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 400;
    color: #5d6478;
  }
  .tag {
    margin-left: 0.4rem;
    padding: 0 5px;
    border-radius: 4px;
    background: #f4c542;
    color: #22263a;
    font-size: 0.7rem;
    font-weight: 500;
    vertical-align: middle;
  }

  /* ---- 在这一章加入的角色 / 纹章士：小头像 + 名字 ---- */
  .joins {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0;
    list-style: none;
  }
  .joins li,
  .joins a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
  }
  .joins li {
    padding: 1px 8px 1px 1px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
  }
  .joins a {
    color: #2a64b8;
    text-decoration: none;
  }
  .joins a:hover {
    text-decoration: underline;
  }
  .joins :global(.thumb) {
    border-radius: 50%;
  }
  .joins .emblem {
    border-color: #f4c542;
    background: #fff8e1;
  }

  /*
   * ---- 下一级的行 ----
   * 两种：.chain（邪龙之章 2–6 章，依次进行，接着上一级的轴往下，--indent: 0）
   * 和 .branches（神龙之章打完第1章后一起解锁的五章，各自往右拐出来）。
   * 列表左移 --gap 贴到上一级的轴上，缩进走每个 li 的 padding，画法和主干上的行完全一样。
   */
  .branches,
  .chain {
    position: relative;
    /* 不留上外边距：上一级的 .event 到这里正好接上，轴不断开（行距由卡片的 margin-bottom 给） */
    margin: 0 0 0.25rem calc(-1 * var(--gap));
    padding: 0;
    list-style: none;
  }
  .chain {
    --indent: 0px;
  }
  .branches {
    /* 分支自己的轴（圆点）再往右让出一整段虚线的宽度，卡片跟着右移，虚线长度不变 */
    --indent: calc(var(--label-s) + 0.5rem + var(--gap));
    --label: var(--label-s); /* 支线编号窄一档（只用于 .marker 的宽度） */
  }

  .branches > li,
  .chain > li {
    position: relative;
    padding-left: calc(var(--indent) + var(--gap));
    border-left: 3px solid var(--side);
  }
  /* 一组的最后一个：圆点在顶边，自己这一行不画线，轴到这里为止 */
  .branches > li:last-child,
  .chain > li:last-child {
    border-left-color: transparent;
  }
  /* 圆点到卡片的虚线 */
  .branches > li::before,
  .chain > li::before {
    content: "";
    position: absolute;
    top: 0;
    left: calc(var(--indent) + 0.9rem);
    width: calc(var(--gap) - 1.15rem);
    border-top: 2px dashed var(--axis);
  }
  /* 轴上的圆点 */
  .branches > li::after,
  .chain > li::after {
    content: "";
    position: absolute;
    left: calc(var(--indent) - 9.5px);
    top: -7px;
    width: 11px;
    height: 11px;
    border: 3px solid var(--side);
    border-radius: 50%;
    background: #fff;
  }

  /* 有缩进的行：从上一级的轴拐出来（神龙之章五章各一条弯道） */
  .branches > li > .event::before {
    content: "";
    position: absolute;
    box-sizing: border-box;
    top: calc(-1 * var(--curve));
    /* 从上一级的轴（左边缘）横过来，在自己的圆点上拐下去：宽度只到自己的轴，不含虚线那一段 --gap */
    left: calc(-1 * (var(--gap) + var(--indent) + 3px));
    width: calc(var(--indent) + 3px);
    height: var(--curve);
    border-top: 3px solid var(--axis);
    border-right: 3px solid var(--axis);
    border-top-right-radius: var(--curve);
  }

  /* 手机：缩短虚线和缩进，给卡片留宽度；编号回到卡片标题上方 */
  @media (max-width: 640px) {
    .branches > li::before,
    .chain > li::before {
      left: calc(var(--indent) + 0.35rem);
      width: 0.6rem;
    }
    .branches {
      --indent: calc(0.4rem + var(--gap));
    }
    .marker,
    .event.main > .marker {
      position: static;
      display: block;
      width: auto;
      height: auto;
      line-height: 1.6;
      text-align: left;
      font-size: 0.9rem;
    }
  }
</style>
