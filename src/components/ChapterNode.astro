---
/**
 * A chapter in the chronological timeline.
 * Represents a chapter or a chapter or a chapter and its side branches in the timeline.
 */

export interface Node {
  id: string;
  type: string;
  name: string;
  title: string;
  isBranch: boolean;
  newChars: { id: string; name: string; img: string }[];
  newEmblems: { name: string; img: string }[];
  children: Node[];
  /** no more indentation for chain, it only works for xenologues */
  chain: Node[];
}

interface Props {
  node: Node;
  hasNext?: boolean; //
  main?: boolean; // 主线节点?
}
const { node, hasNext, main = false } = Astro.props;
const dlc = node.type === "divine" || node.type === "xenologue";
---

<div
  class:list={[
    "event",
    { main, dlc, grouped: node.children.length + node.chain.length > 0 },
  ]}
  id={node.id}
  data-desciption="chapter-node"
>
  <div
    class="grid grid-cols-[24px_1fr] sm:grid-cols-[32px_1fr] relative"
    data-desciption="chapter-header"
  >
    <div
      class:list={[
        "timeline-dot col-start-2 flex gap-2 text-xl",
        {
          "dot-main": node.type === "main",
          "dot-paralogue": node.type === "paralogue",
          "dot-xenologue": node.type === "xenologue",
          "dot-divine": node.type === "divine",
        },
      ]}
    >
      <div class="font-bold">{node.name}</div>
      <div>{node.title}</div>
    </div>
  </div>
  <div
    class="chapter-main grid grid-cols-[24px_1fr] sm:grid-cols-[32px_1fr] relative"
    data-desciption="chapter-main"
  >
    <div
      class:list={[
        "timeline-line absolute top-0 bottom-0 start-0 w-6 sm:w-8",
        { hidden: !hasNext && node.id != "d1" },
      ]}
      aria-hidden="true"
    ></div>
    <div class="col-start-2 text-base mb-2">content of chapter</div>
    {node.chain.length > 0 && (
      <ol class="timeline-curve ml-3 sm:ml-4 col-span-2">
        {node.chain.map((next, i, arr) => (
          <li data-type={next.type}>
            <Astro.self node={next} hasNext={i !== arr.length - 1} />
          </li>
        ))}
      </ol>
    )}
    {node.children.length > 0 &&
      node.children.map((child) => (
        <ul
          class:list={[
            "timeline-curve ml-3 sm:ml-4 col-span-2",
            { timeline_end_fix: child.id === "d6" },
          ]}
        >
          <li data-type={child.type}>
            <Astro.self node={child} />
          </li>
        </ul>
      ))}
  </div>
</div>

<style>
  .timeline-dot::before {
    content: "";
    position: absolute;
    left: 0.75rem;
    top: 0.5rem;
    width: 0.5rem;
    height: 0.5rem;
    border: 2px solid var(--color-dot, var(--color-brand-black, #000));
    border-radius: 50%;
    background: #fff;
    transform: translateX(-50%);

    @media (min-width: 640px) {
      left: 1rem;
      top: 0.5rem;
    }
  }

  .dot-main {
    --color-dot: var(--color-brand-black);
  }
  .dot-paralogue {
    --color-dot: var(--color-kind-character);
  }
  .dot-xenologue {
    --color-dot: var(--color-kind-engrave);
  }
  .dot-divine {
    --color-dot: var(--color-kind-weapon);
  }

  .timeline-line::before {
    content: "";
    display: block;
    height: 100%;
    width: 1px;
    background: var(--color-brand-border);
    margin-inline-start: calc(0.75rem - 0.5px);

    @media (min-width: 640px) {
      margin-inline-start: calc(1rem - 0.5px);
    }
  }

  .timeline_end_fix {
    position: relative;
  }
  .timeline_end_fix::before {
    content: "";
    position: absolute;
    background: white;
    left: -1px;
    height: 100%;
    width: 2px;
  }

  .timeline-curve {
    position: relative;
  }
  .timeline-curve::after {
    content: "";
    position: absolute;
    height: 0.5rem;
    box-sizing: border-box;
    border: 0px solid var(--color-brand-border);
    border-inline-start-width: 1px;
    border-bottom-width: 1px;
    border-end-start-radius: 1rem;
    top: 0;
    width: 0.5rem;

    @media (min-width: 640px) {
      height: 1rem;
      border-end-start-radius: 2rem;
      width: 1rem;
    }
  }
</style>
