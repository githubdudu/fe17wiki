---
/**
 * 特技摘要：图标 + 名称（链接到 /skills/<id>）+ 效果说明，数据全部来自 skills.csv。
 * 特技列表页和角色表的「个人特技」格共用；compact 用于表格格子（图标小、字小）。
 * 默认插槽放在最右侧，给调用方追加内容（如列表页的纹章士 / 角色要求标签）。
 */
import type { CollectionEntry } from "astro:content";
import Thumb from "./Thumb.astro";

interface Props {
  skill: CollectionEntry<"skills">;
  compact?: boolean;
}
const { skill, compact = false } = Astro.props;
const d = skill.data;
---

<div class=`flex items-start ${compact ? "gap-2" : "gap-3"}`>
  <Thumb src={d["图标"]} alt="" size={compact ? 24 : 40} />
  <div class="flex-1 min-w-0">
    <p class=`name ${compact ? "text-sm" : "text-base"} font-bold`>
      <a
        class="text-brand-blue hover:underline focus-visible:outline-brand-orange focus-visible:outline-3 focus-visible:outline-offset-2 no-underline"
        href={`/skills/${skill.id}`}>{d["特技名称"]}</a
      >
    </p>
    <p class=`text-brand-gray ${compact ? "text-xs" : "text-sm"}`>
      {d["详细效果说明"]}
    </p>
  </div>
  <slot />
</div>
