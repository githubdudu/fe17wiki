---
/** 按阵营分组的角色表：每组一个标题行，下面每行三个头像，空位补「-」。 */
import type { CollectionEntry } from "astro:content";
import CharacterCard from "./CharacterCard.astro";

interface Props {
  characters: CollectionEntry<"characters">[];
}

const COLS = 3;
// 分组和组的先后都来自 CSV：「分组」列 + 行序。
const groups = Map.groupBy(
  [...Astro.props.characters].sort((a, b) => a.data.order - b.data.order),
  (c) => c.data["分组"],
);
---

<div class="roster" style={`--cols: ${COLS}`}>
  {
    [...groups].map(([label, list]) => (
      <section>
        <h3>{label}</h3>
        <ul>
          {list.map((c) => <li><CharacterCard id={c.id} name={c.data["角色名称_简中"]} /></li>)}
          {Array.from({ length: (COLS - (list.length % COLS)) % COLS }, () => <li class="empty">-</li>)}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .roster {
    --line: #d4dde2;
    border: 1px solid var(--line);
  }
  h3 {
    margin: 0;
    padding: 0.35rem;
    text-align: center;
    font-size: 0.85rem;
    background: #f1f5f7;
    border-bottom: 1px solid var(--line);
  }
  section + section h3 {
    border-top: 1px solid var(--line);
  }
  ul {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    place-items: center;
    padding: 0.375rem 0.125rem;
    background: #fff;
  }
  .empty {
    color: #999;
  }
</style>
