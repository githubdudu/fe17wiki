---
/** 页面骨架：顶部菜单 + 侧边栏（仅桌面）+ 主内容。侧边栏用 slot="sidebar" 传入。 */
const path = Astro.url.pathname;
---

<div class="nav-layout">
  <nav class="menu" aria-label="主菜单">
    <a href="/" aria-current={path === "/" ? "page" : undefined}>首页</a>
    <a href="/characters" aria-current={path.startsWith("/characters") ? "page" : undefined}>角色</a>
    <a href="/skills" aria-current={path.startsWith("/skills") ? "page" : undefined}>特技</a>
  </nav>
  <aside><slot name="sidebar" /></aside>
  <main><slot /></main>
</div>

<style>
  /* 手机优先：单列。桌面布局相同，只在左边多出侧边栏。 */
  .nav-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "menu" "main";
  }
  .nav-layout > .menu { grid-area: menu; }

  /* 顶部菜单：和栏目标题栏同一套配色（深蓝底 + 珊瑚色底边） */
  .menu {
    display: flex;
    background: #262a3f;
    border-bottom: 4px solid #e0735a;
  }
  .menu a {
    padding: 0.6rem 1rem;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
  .menu a:hover {
    background: #353a57;
  }
  .menu a[aria-current="page"] {
    background: #e0735a;
  }
  .menu a:focus-visible {
    outline: 3px solid #f4c542;
    outline-offset: -3px;
  }
  .nav-layout > aside { display: none; }
  .nav-layout > main {
    grid-area: main;
    width: 100%;
    max-width: 720px;
    justify-self: center;
    padding: 0 12px 24px;
    box-sizing: border-box;
  }

  @media (min-width: 960px) {
    .nav-layout {
      grid-template-columns: 240px minmax(0, 720px);
      grid-template-areas: "menu menu" "aside main";
      justify-content: center;
      column-gap: 24px;
    }
    .nav-layout > aside { display: block; grid-area: aside; }
  }

  /* 页面内有勾选的 .widen 选框时（如角色清单勾选「成长率」），主内容加宽到 1320px */
  :global(.nav-layout:has(.widen:checked) > main) {
    max-width: 1320px;
  }
  @media (min-width: 960px) {
    :global(.nav-layout:has(.widen:checked)) {
      grid-template-columns: 240px minmax(0, 1320px);
    }
  }
</style>
