---
/** 角色头像：按 id 取 src/assets/characters/<id>.webp；没有图时显示同尺寸灰块。 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  id: string;
  alt: string;
  size: number;
}
const { id, alt, size } = Astro.props;

const portraits = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/characters/*.webp",
  { eager: true },
);
const portrait = portraits[`/src/assets/characters/${id}.webp`]?.default;
---

{
  portrait ? (
    <Image class="portrait" src={portrait} alt={alt} width={size} height={size} densities={[1, 2]} />
  ) : (
    <span class="portrait placeholder" style={`width: ${size}px`} />
  )
}

<style>
  .portrait {
    display: block;
    max-width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 6px;
  }
  .placeholder {
    background: #e5e5e5;
  }
</style>
