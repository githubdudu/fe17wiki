---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavLayout from "../../components/NavLayout.astro";
import ChapterNode, { type Node } from "../../components/ChapterNode.astro";
import ChapterTree from "../../components/ChapterTree.astro";

const byOrder = (
  a: { data: { order: number } },
  b: { data: { order: number } },
) => a.data.order - b.data.order;
const chapters = (await getCollection("chapters")).sort(byOrder);
const characters = (await getCollection("characters")).sort(byOrder);
const emblems = (await getCollection("emblems")).sort(byOrder);

// 1. Check the references of chapters ids. If the parent node is not found, print the error message.
const ids = new Set(chapters.map((c) => c.id));
const check = (what: string, ref: string) => {
  if (!ids.has(ref)) console.error(`chapters.csv 里没有「${ref}」（${what})`);
};
chapters.forEach(
  (c) => c.data["父节点"] && check(`${c.id} 的父节点`, c.data["父节点"]),
);
characters.forEach((c) => check(`角色 ${c.id} 的章节id`, c.data["章节id"]));
emblems.forEach((e) => check(`纹章士 ${e.id} 的章节id`, e.data["章节id"]));

// Convert type
const typeTrans: Record<string, string> = {
  主线: "main",
  外传: "paralogue",
  神龙之章: "divine",
  邪龙之章: "xenologue",
};

// 2. Create a map of chapter id which helps build the tree faster.
// The Emblems avatars img are stored by character name. If they share a ring (e.g., "Kurobu/Rufurei"), take the first character.
const mapFunc = (c: (typeof chapters)[number]): [string, Node] => [
  c.id,
  {
    id: c.id,
    type: typeTrans[c.data["类型"]],
    name: c.data["章节名称"],
    title: c.data["章节标题"],
    isBranch: typeTrans[c.data["类型"]] !== "main",
    newChars: characters
      .filter((ch) => ch.data["章节id"] === c.id)
      .map((ch) => ({
        id: ch.id,
        name: ch.data["角色名称_简中"],
        img: ch.data["头像"],
      })),
    newEmblems: emblems
      .filter((e) => e.data["章节id"] === c.id)
      .map((e) => ({
        name: e.data["纹章士"],
        img: `src/assets/emblems/${e.data["纹章士"].split("/")[0]}.webp`,
      })),
    children: [],
    chain: [],
  },
];
const chaptersMap = new Map<string, Node>(chapters.map(mapFunc));

// 3. Attach the paralogue to its parent node as children
// Attach the divine chapters to its parent node as children
// Attach the xenologue chapters to its parent node as chain
chapters.forEach((c) => {
  if (c.data["类型"] === "外传")
    chaptersMap.get(c.data["父节点"])!.children.push(chaptersMap.get(c.id)!);
  // Attach the divine chapters.
  else if (c.data["类型"] === "神龙之章")
    chaptersMap.get(c.data["父节点"])!.children.push(chaptersMap.get(c.id)!);
  // Attach the xenologue chapters as chain which is displayed as a list.
  else if (c.data["类型"] === "邪龙之章")
    chaptersMap.get(c.data["父节点"])!.chain.push(chaptersMap.get(c.id)!);
});

// 4. Select the main chapters as the main list from the map.
// Others are childrens or chains. The way of displaying them is like treating them as comments.
const mainList = chapters
  .filter((c) => c.data["类型"] === "主线")
  .map((c) => chaptersMap.get(c.id)!);

console.dir({ mainList }, { depth: 10 });
---

<BaseLayout
  title="章节流程"
  description="火焰纹章结合全部章节流程：主线序章到第26章，外传与神龙之章、邪龙之章 DLC 在哪一章解锁，以及每一章加入的角色和纹章士。"
>
  <NavLayout>
    <div class="chapters">
      <h1 class="text-2xl font-medium my-4">章节流程</h1>
      <p class="lead flex gap-2 text-brand-gray text-base">
        <span
          class="color-main before:inline-block before:w-4 before:border-b-4 before:border-brand-black"
          >&nbsp;主线</span
        >
        <span
          class="color-paralogue before:inline-block before:w-4 before:border-b-4 before:border-kind-character"
          >&nbsp;外传</span
        >
        <span
          class="color-divine before:inline-block before:w-4 before:border-b-4 before:border-kind-weapon"
          >&nbsp;神龙之章</span
        >
        <span
          class="color-xenologue before:inline-block before:w-4 before:border-b-4 before:border-kind-engrave"
          >&nbsp;邪龙之章</span
        >
      </p>
      <ChapterTree trunk={mainList} />
    </div>
  </NavLayout>
</BaseLayout>

<style>
  /*
   * 页面骨架 + 主干时间轴。支线（外传 / DLC）的轴和卡片样式在 ChapterNode.astro 里，
   * 两边共用这里定义的这几个变量。
   */
  .chapters {
    --axis: #262a3f; /* 主线轴 */
    --side: #5d6478; /* 支线轴（默认，实际颜色按 data-type 取） */
    --shadow: #262a3f26; /* 对应主色的阴影 */
    --line: #d4dde2; /* 卡片、胶囊边框 */
    --gap: 10rem; /* 圆点到卡片的距离 = 虚线长度 */
    --label: 4rem; /* 圆点左边编号的宽度（主线） */
    --label-s: 7rem; /* 支线编号较长（「邪龙之章 第2章」），折成两行刚好 */
    --curve: 32px; /* 支线离开主干时的圆角半径 */
    color: #22263a;
  }
</style>
