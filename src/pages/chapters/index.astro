---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavLayout from "../../components/NavLayout.astro";
import ChapterNode, { type Node } from "../../components/ChapterNode.astro";

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
const chapters = (await getCollection("chapters")).sort(byOrder);
const characters = (await getCollection("characters")).sort(byOrder);
const emblems = (await getCollection("emblems")).sort(byOrder);

// 引用要能对上，对不上就让构建失败，免得有人悄悄从页面上消失
const ids = new Set(chapters.map((c) => c.id));
const check = (what: string, ref: string) => {
  if (!ids.has(ref)) throw new Error(`chapters.csv 里没有「${ref}」（${what}）`);
};
chapters.forEach((c) => c.data["父节点"] && check(`${c.id} 的父节点`, c.data["父节点"]));
characters.forEach((c) => check(`角色 ${c.id} 的章节id`, c.data["章节id"]));
emblems.forEach((e) => check(`纹章士 ${e.id} 的章节id`, e.data["章节id"]));

// 纹章士头像按人名存放，共用戒指的（如「库洛武/鲁弗莱」）取第一人（同纹章士页）
const nodes = new Map<string, Node>(
  chapters.map((c) => [
    c.id,
    {
      id: c.id,
      type: c.data["类型"],
      no: c.data["编号"],
      name: c.data["名称"],
      chars: characters
        .filter((ch) => ch.data["章节id"] === c.id)
        .map((ch) => ({ id: ch.id, name: ch.data["角色名称_简中"], img: ch.data["头像"] })),
      emblems: emblems
        .filter((e) => e.data["章节id"] === c.id)
        .map((e) => ({ name: e.data["纹章士"], img: `src/assets/emblems/${e.data["纹章士"].split("/")[0]}.webp` })),
      children: [],
      chain: [],
    },
  ]),
);
// 主干收「没有父节点的主线章节」+「父节点是主线的分支根节点」（外传 / 神龙之章 / 邪龙之章第1章），
// 一条分支整体是主干上的一个 li，排在解锁它的章节后面（CSV 行序 = 时间顺序）
const isTrunk = (c: (typeof chapters)[number]) =>
  !c.data["父节点"] || nodes.get(c.data["父节点"])!.type === "主线";
// 分支内部的章节才挂到父节点下（神龙之章的五章、邪龙之章第2–6章）
chapters.forEach((c) => !isTrunk(c) && nodes.get(c.data["父节点"])!.children.push(nodes.get(c.id)!));
// 侧枝里「只有一个同类型子节点」的是依次进行的章节（邪龙之章 1→6），收成一条链；
// 同一个父节点下有多个同类型子节点（神龙之章的五个外传）则仍是并列的侧枝
for (const n of nodes.values()) {
  let cur = n;
  while (n.type !== "主线" && cur.children.length === 1 && cur.children[0].type === n.type) {
    const next = cur.children[0];
    cur.children = [];
    n.chain.push(next);
    cur = next;
  }
}
const trunk = chapters.filter(isTrunk).map((c) => nodes.get(c.id)!);
---

<BaseLayout
  title="章节流程"
  description="火焰纹章结合全部章节流程：主线序章到第26章，外传与神龙之章、邪龙之章 DLC 在哪一章解锁，以及每一章加入的角色和纹章士。"
>
  <NavLayout>
    <div class="chapters">
      <h1>章节流程</h1>
      <p class="lead">主线从上到下；外传和 DLC 从解锁它的章节向右分出。</p>
      <ol class="trunk">
        {
          trunk.map((node) => (
            <li data-type={node.type}>
              <ChapterNode node={node} main={node.type === "主线"} />
            </li>
          ))
        }
      </ol>
    </div>
  </NavLayout>
</BaseLayout>

<style>
  /*
   * 页面骨架 + 主干时间轴。支线（外传 / DLC）的轴和卡片样式在 ChapterNode.astro 里，
   * 两边共用这里定义的这几个变量。
   */
  .chapters {
    --axis: #262a3f; /* 主线轴 */
    --side: #5d6478; /* 支线轴（默认，实际颜色按 data-type 取） */
    --shadow: #262a3f26; /* 对应主色的阴影 */
    --line: #d4dde2; /* 卡片、胶囊边框 */
    --gap: 10rem; /* 圆点到卡片的距离 = 虚线长度 */
    --label: 4rem; /* 圆点左边编号的宽度（主线） */
    --label-s: 7rem; /* 支线编号较长（「邪龙之章 第2章」），折成两行刚好 */
    --curve: 32px; /* 支线离开主干时的圆角半径 */
    color: #22263a;
  }
  .chapters h1 {
    margin: 1rem 0 0.25rem;
    font-size: 1.4rem;
    text-align: center;
  }
  .lead {
    margin: 0 0 1.25rem;
    color: #5d6478;
    font-size: 0.85rem;
    text-align: center;
  }

  /* ---- 轴的颜色：每种类型一个（按 CSV 的「类型」，不在代码里做映射表）；往下继承给分支内部的章节 ---- */
  .trunk > li[data-type="外传"] {
    --axis: #3b6fd6;
  }
  .trunk > li[data-type="神龙之章"] {
    --axis: #d99400;
  }
  .trunk > li[data-type="邪龙之章"] {
    --axis: #7d4bc7;
  }

  /*
   * 主干：每个 li 左边一条竖线（主干轴，本行这一段），li::after 是轴上的圆点，li::before 是圆点到卡片的虚线。
   * 圆点、虚线、编号都在每一行的顶边，所以轴从圆点起画，最后一行不画线即可。
   * 分支（外传 / DLC）也是主干上的一行，只是 --indent 把它整行往右挪一档、再用弯道从主干拐出来；
   * 主干轴照旧穿过这一行（所以缩进走 padding 而不是 margin）。整条轴右移 --label，给左边的编号腾地方。
   */
  .trunk {
    margin: 0;
    padding-left: var(--label);
    list-style: none;
  }
  .trunk > li {
    --indent: 0px;
    position: relative;
    padding-left: calc(var(--indent) + var(--gap));
    border-left: 3px solid var(--axis);
  }
  .trunk > li:not([data-type="主线"]) {
    /* 分支自己的轴（圆点）再往右让出一整段虚线的宽度，卡片跟着右移，虚线长度不变 */
    --indent: calc(var(--gap));
    --label: var(--label-s); /* 支线编号窄一档（只用于 .marker 的宽度） */
  }
  .trunk > li:last-child {
    border-left-color: transparent;
  }
  .trunk > li::before {
    content: "";
    position: absolute;
    top: 0;
    left: calc(var(--indent) + 0.9rem);
    width: calc(var(--gap) - 1.15rem);
    border-top: 2px dashed var(--axis);
  }
  .trunk > li::after {
    content: "";
    position: absolute;
    left: calc(var(--indent) - 9.5px);
    top: -7px;
    width: 11px;
    height: 11px;
    border: 3px solid var(--side);
    border-radius: 50%;
    background: #fff;
  }
  /* 分支：从主干的轴拐出来，弯道是这条分支自己的颜色（.event 是 ChapterNode 的元素，要 :global 才选得到） */
  .trunk > li:not([data-type="主线"]) > :global(.event)::before {
    content: "";
    position: absolute;
    box-sizing: border-box;
    top: calc(-1 * var(--curve));
    /* 从主干轴横过来，在自己的圆点上拐下去：宽度只到自己的轴，不含虚线那一段 --gap */
    left: calc(-1 * (var(--gap) + var(--indent) + 3px));
    width: calc(var(--indent) + 3px);
    height: var(--curve);
    border-top: 3px solid var(--axis);
    border-right: 3px solid var(--axis);
    border-top-right-radius: var(--curve);
  }

  /* 手机：没有左侧空位，轴贴到最左边，虚线和缩进都缩短 */
  @media (max-width: 640px) {
    .chapters {
      --gap: 1.25rem;
    }
    .trunk {
      padding-left: 0;
    }
    .trunk > li:not([data-type="主线"]) {
      --indent: calc(0.4rem + var(--gap));
    }
    .trunk > li::before {
      left: calc(var(--indent) + 0.35rem);
      width: 0.6rem;
    }
  }
</style>
