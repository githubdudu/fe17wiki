---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavLayout from "../../components/NavLayout.astro";
import TeamPlanner from "../../components/TeamPlanner";

const byOrder = (
  a: { data: { order: number } },
  b: { data: { order: number } },
) => a.data.order - b.data.order;

// 和 Thumb.astro 一样按 CSV 里的路径找图，这里只要 URL 交给 React。
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.webp",
  { eager: true },
);
const url = (p: string) => images[`/${p}`]?.default.src;

const characters = (await getCollection("characters"))
  .sort(byOrder)
  .map((c) => ({
    id: c.id,
    name: c.data["角色名称_简中"],
    img: url(c.data["头像"]),
    initClass: c.data["初始职业"],
    group: c.data["分组"],
  }));
// 同名兵种在 CSV 里按变体分多行，这里每个名字只要一个。
const classes = [
  ...new Map(
    (await getCollection("classes")).sort(byOrder).map((c) => [
      c.data["兵种名称"],
      {
        name: c.data["兵种名称"],
        group: c.data["分类"],
        img: url(`src/assets/classes/${c.data["兵种名称"]}.webp`),
      },
    ]),
  ).values(),
];
// 共用戒指的纹章士（如「库洛武/鲁弗莱」）取第一人的头像。
const emblems = (await getCollection("emblems")).sort(byOrder).map((e) => ({
  name: e.data["纹章士"],
  img: url(`src/assets/emblems/${e.data["纹章士"].split("/")[0]}.webp`),
  group: e.data["章节id"].includes("ch") ? "本篇纹章士" : "DLC纹章士"
}));
---

<BaseLayout>
  <NavLayout>
    <TeamPlanner
      client:only="react"
      characters={characters}
      classes={classes}
      emblems={emblems}
    />
  </NavLayout>
</BaseLayout>
