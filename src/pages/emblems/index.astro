---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavLayout from "../../components/NavLayout.astro";
import Thumb from "../../components/Thumb.astro";

const emblems = (await getCollection("emblems")).sort(
  (a, b) => a.data.order - b.data.order,
);

// 头像按人名存放：src/assets/emblems/<人名>.webp（取自原始 xlsx）。
// 共用戒指的纹章士（如「库洛武/鲁弗莱」）每人一张；原表没有鲁弗莱的图，没有图的人不显示。
const images = new Set(
  Object.keys(import.meta.glob("/src/assets/emblems/*.webp")),
);
const portraitsOf = (names: string) =>
  names
    .split("/")
    .map((n) => `src/assets/emblems/${n}.webp`)
    .filter((p) => images.has(`/${p}`));
---

<BaseLayout>
  <NavLayout>
    <div slot="sidebar">Sidebar</div>
    <h1 class="my-4 text-2xl font-bold">
      纹章士 <span class="text-brand-gray text-md font-medium">
        {emblems.length}
      </span>
    </h1>

    <ul class="emblems grid grid-cols-1 md:grid-cols-2 gap-3">
      {
        emblems.map((e) => {
          const d = e.data;
          return (
            <li class="card flex flex-col gap-3 p-4 border border-brand-border rounded-md text-brand-black ">
              <header class="flex whitespace-pre-line items-center gap-3 ">
                <div class="portraits flex flex-none [&>*+*]:-ml-3">
                  {portraitsOf(d["纹章士"]).map((src) => (
                    <Thumb src={src} alt="" size={56} />
                  ))}
                </div>
                <div class="self-stretch border-b border-brand-border">
                  <h2 class="text-xl font-medium">{d["纹章士"]}</h2>
                  <p class="works  text-xs text-brand-gray">{d["登场作品"]}</p>
                </div>
              </header>

              <p class="intro whitespace-pre-line text-base">{d["简介"]}</p>

              <dl class="whitespace-pre-line grid gap-1 [&>div]:grid [&>div]:grid-cols-[4.5rem_1fr] [&>div]:gap-2">
                <div class="text-sm">
                  <dt class="text-brand-gray">声优</dt>
                  <dd class="font-medium">{d["声优"]}</dd>
                </div>
                <div class="text-sm">
                  <dt class="text-brand-gray">加入</dt>
                  <dd class="text-sm">
                    <span class="block font-medium">{d["加入章节"]}</span>
                    <span class="text-xs text-brand-gray">{d["加入条件"]}</span>
                  </dd>
                </div>
                <div class="text-sm">
                  <dt class="text-brand-gray">满级加成</dt>
                  <dd class="flex flex-wrap gap-1 whitespace-normal font-medium">
                    {d["满级能力加成"].split("\n").map((b: string) => (
                      <span class="px-2 rounded-md bg-brand-lightblue font-[Barlow]">
                        {b}
                      </span>
                    ))}
                  </dd>
                </div>
              </dl>
            </li>
          );
        })
      }
    </ul>
  </NavLayout>
</BaseLayout>
