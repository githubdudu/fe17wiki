---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavLayout from "../../components/NavLayout.astro";
import SkillSummary from "../../components/SkillSummary.astro";
import InfoTip from "../../components/InfoTip.astro";

const skills = (await getCollection("skills")).sort(
  (a, b) => a.data.order - b.data.order,
);
// 分组和组的先后都来自 CSV：「特技类型」列 + 行序
const groups = [...Map.groupBy(skills, (s) => s.data["特技类型"])];

// 各特技类型的说明（分组标题旁的「i」）
const TYPE_TIPS: Record<string, string[]> = {
  个人特技: ["每个角色独有的特技，始终生效，不能更换，也不能继承给其他角色。"],
  兵种特技: [
    "职业自带的特技，转职成该职业后获得。",
    "部分特技要在该职业达到一定等级后才习得，详见各特技的备注。",
  ],
  "纹章士-同步特技": [
    "佩戴纹章士戒指时自动生效的特技，随着和该纹章士的羁绊等级提升依次解锁。",
    "大部分同步特技也可以消耗 SP 继承，继承后不佩戴戒指也能装备。",
  ],
  "纹章士-继承特技": [
    "和纹章士的羁绊等级达到要求后，在戒指之间消耗 SP 学习的特技。",
    "学会后即使不佩戴该纹章士的戒指也能装备，每个角色最多同时装备 2 个继承特技。",
  ],
  "纹章士-结合特技": ["和纹章士「结合」时才生效的特技，不能继承。"],
  "纹章士-结合指令技": [
    "和纹章士「结合」时才能使用的指令，大多是威力很强的结合技，不能继承。",
  ],
  牵绊戒指特技: ["佩戴对应的牵绊戒指时才生效的特技。"],
};
---

<BaseLayout>
  <NavLayout>
    <div slot="sidebar">Sidebar</div>
    <h1 class="text-2xl font-bold my-4">特技</h1>

    <nav class="flex flex-wrap gap-2 mb-4" aria-label="特技类型">
      {
        groups.map(([type, list], i) => (
          <a
            href={`#type-${i}`}
            class="text-brand-blue focus-visible:outline-brand-orange focus-visible:outline-offset-4 text-xs underline"
          >
            {type}
          </a>
        ))
      }
    </nav>

    {
      groups.map(([type, list], i) => (
        <section class="mb-6 scroll-mt-4" id={`type-${i}`}>
          <h2 class="py-2 px-3 font-bold border border-brand-border bg-brand-lightblue text-lg">
            {type}
            <span class="ml-2 font-medium text-black/70">
              共{list.length}个
            </span>
            {TYPE_TIPS[type] && (
              <InfoTip id={`info-type-${i}`} label={type}>
                {TYPE_TIPS[type].map((t) => (
                  <p>{t}</p>
                ))}
              </InfoTip>
            )}
          </h2>
          <ul>
            {list.map((s) => {
              const d = s.data;
              const tags = [d["纹章士"], d["角色要求"], d["兵种要求"]].filter(
                Boolean,
              );
              return (
                <li class="py-2 px-3 border border-brand-border hover:bg-brand-hover">
                  <SkillSummary skill={s}>
                    {tags.length > 0 && (
                      <p class="tags flex flex-wrap justify-end gap-1 max-w-[40%]">
                        {tags.map((t) => (
                          <span class="px-2 rounded-sm bg-brand-lightblue text-brand-gray text-xs">
                            {t}
                          </span>
                        ))}
                      </p>
                    )}
                  </SkillSummary>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </NavLayout>
</BaseLayout>
