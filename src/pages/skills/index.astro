---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavLayout from "../../components/NavLayout.astro";
import SkillSummary from "../../components/SkillSummary.astro";

const skills = (await getCollection("skills")).sort((a, b) => a.data.order - b.data.order);
// 分组和组的先后都来自 CSV：「特技类型」列 + 行序
const groups = [...Map.groupBy(skills, (s) => s.data["特技类型"])];
---

<BaseLayout>
  <NavLayout>
    <div slot="sidebar">Sidebar</div>
    <h1>特技</h1>

    <nav class="types" aria-label="特技类型">
      {
        groups.map(([type, list], i) => (
          <a href={`#type-${i}`}>
            {type}
            <span>{list.length}</span>
          </a>
        ))
      }
    </nav>

    {
      groups.map(([type, list], i) => (
        <section id={`type-${i}`}>
          <h2>
            {type}
            <span>{list.length}</span>
          </h2>
          <ul>
            {list.map((s) => {
              const d = s.data;
              const tags = [d["纹章士"], d["角色要求"], d["兵种要求"]].filter(Boolean);
              return (
                <li>
                  <SkillSummary skill={s}>
                    {tags.length > 0 && (
                      <p class="tags">
                        {tags.map((t) => (
                          <span>{t}</span>
                        ))}
                      </p>
                    )}
                  </SkillSummary>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </NavLayout>
</BaseLayout>

<style>
  h1 {
    margin: 1rem 0 0.75rem;
    font-size: 1.4rem;
  }

  /* 顶部类型导航：点击跳到对应分组 */
  .types {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }
  .types a {
    padding: 0.2rem 0.75rem;
    border: 1px solid #2a64b8;
    border-radius: 999px;
    color: #2a64b8;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
  }
  .types a:hover,
  .types a:focus-visible {
    background: #2a64b8;
    color: #fff;
  }
  .types a:focus-visible {
    outline: 3px solid #f4c542;
    outline-offset: 2px;
  }
  .types span,
  h2 span {
    margin-left: 0.3rem;
    font-weight: 400;
    opacity: 0.7;
  }

  section {
    margin-bottom: 1.5rem;
    scroll-margin-top: 1rem;
  }
  h2 {
    margin: 0;
    padding: 0.4rem 0.75rem;
    border: 1px solid #d4dde2;
    background: #f1f5f7;
    font-size: 0.9rem;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    padding: 0.6rem 0.75rem;
    border: 1px solid #d4dde2;
    border-top: 0;
    background: #fff;
  }
  li:hover {
    background: #eef3fb;
  }
  /* 标签放在 SkillSummary 的插槽里，位于右侧；标签多时在右侧换行，最多占 40% 宽 */
  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem;
    max-width: 40%;
    margin: 0;
  }
  .tags span {
    padding: 0 0.4rem;
    border-radius: 3px;
    background: #f1f5f7;
    color: #5d6478;
    font-size: 0.7rem;
  }
</style>
